# SOLO nombres de variables. Los valores reales se cargan en el panel de DCM
# (Proyecto -> Environment), nunca en este repositorio.

# URL pública HTTPS del servicio, sin barra final.
# Inicial: la del dominio temporal de DCM (https://<slug>.dcm.devex.pe)
SERVER_URL=https://CAMBIAR.dcm.devex.pe

# Clave de administración de la API (header "apikey"). Aleatoria, >= 32 caracteres.
AUTHENTICATION_API_KEY=

# Contraseñas de PostgreSQL y Redis. Solo letras y números (van dentro de una URL).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
